import { randomBytes, scryptSync } from "node:crypto";
import { createInterface } from "node:readline/promises";
const rl = createInterface({ input: process.stdin, output: process.stdout });
const password = await rl.question("Choose a strong shared password (input visible): ");
rl.close();
if (password.length < 16) { console.error("Use at least 16 characters"); process.exit(1); }
const salt = randomBytes(16).toString("hex");
console.log("\nAdd these values to Vercel Environment Variables (do not commit them):");
console.log("AUTH_PASSWORD_HASH=" + salt + ":" + scryptSync(password, salt, 64).toString("hex"));
console.log("AUTH_SESSION_SECRET=" + randomBytes(48).toString("base64url"));
